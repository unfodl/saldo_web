# Base URL of the bluto auth API (includes the /native/api prefix), exposed
# to the client build (Vite only inlines env vars prefixed VITE_). Defaults to
# http://localhost:8081/native/api in development if unset; a production
# build refuses to build unless this is set to a non-localhost URL — see
# .env.production.
VITE_BLUTO_API_URL="http://localhost:8081/native/api"

# Crossmint CLIENT-SIDE publishable key (prefixed ck_staging_ / ck_production_
# in the Crossmint Console). Used to read a wallet's USDC balance directly
# from the browser (see src/api/crossmintApi.ts) and to send payments via
# wallet.send() (see src/lib/crossmint/client.ts). Needs at least
# wallets.read + wallets:balance.read + wallets:transactions.create scopes.
# TODO: UNVERIFIED whether a ck_ key has enough permission for the send path —
# if wallet.send() throws a permission error, this may need to be an sk_
# secret key instead (see the warning on CROSSMINT_SIGNER_SECRET below; the
# same "shipped to the browser on purpose" tradeoff would then apply here too).
VITE_CROSSMINT_API_KEY="ck_staging_..."

# ⚠️ SECRET key, intentionally exposed to the browser — see the warning in
# src/api/crossmintConfig.ts. This is the "server" recovery signer's secret
# for the store's Crossmint wallet: whoever has it can move funds out of that
# wallet. It ships in the public JS bundle here because this app has no
# server to keep it behind. Only set this in a locked-down internal/staging
# environment with a low-value wallet.
VITE_CROSSMINT_SIGNER_SECRET="..."
