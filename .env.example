# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/saldo_web"

# Base URL of the bluto auth API (includes the /native/api prefix). Defaults
# to http://localhost:8081/native/api in development; required in production
# (e.g. https://bluto.onrender.com/native/api).
BLUTO_API_URL="http://localhost:8081/native/api"

# The /admin login page authenticates against bluto's POST /auth/admin/login
# endpoint (under BLUTO_API_URL above), which today checks a single shared
# credential set via bluto's own EMAILADDRESS/PASSWORD env vars (not
# per-user) — set those in bluto's env, not here, and use those same values
# to sign in at /admin/login. On success, bluto's response also includes an
# access token that's saved in this app's own admin session cookie and reused
# as the Authorization header for later admin calls (e.g. GET /user/list) —
# no separate service credential needed here.

# Crossmint (server-side only — never expose to the browser)
# Environment (staging vs production) is inferred from the CROSSMINT_API_KEY prefix.
CROSSMINT_API_KEY="sk_staging_..."

# Random secret used to deterministically derive each store wallet's server
# signer. Never sent to Crossmint — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CROSSMINT_SIGNER_SECRET="replace-with-a-long-random-string"

# Random 32+ byte secret used to sign operator session cookies
SESSION_SECRET="replace-with-a-long-random-string"
