# Base URL of the bluto auth API (includes the /native/api prefix), exposed
# to the client build (Vite only inlines env vars prefixed VITE_). Defaults to
# http://localhost:8081/native/api in development if unset; a production
# build refuses to build unless this is set to a non-localhost URL — see
# .env.production.
VITE_BLUTO_API_URL="http://localhost:8081/native/api"

# Crossmint CLIENT-SIDE publishable key (prefixed ck_staging_ / ck_production_
# in the Crossmint Console — safe to expose). Used ONLY to read a wallet's
# USDC balance directly from the browser (see src/api/crossmintApi.ts). Needs
# at least the wallets.read + wallets:balance.read scopes.
VITE_CROSSMINT_API_KEY="ck_staging_..."
