# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/saldo_web"

# Crossmint (server-side only — never expose to the browser)
# Environment (staging vs production) is inferred from the CROSSMINT_API_KEY prefix.
CROSSMINT_API_KEY="sk_staging_..."

# Random secret used to deterministically derive each store wallet's server
# signer. Never sent to Crossmint — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CROSSMINT_SIGNER_SECRET="replace-with-a-long-random-string"

# Random 32+ byte secret used to sign operator session cookies
SESSION_SECRET="replace-with-a-long-random-string"
