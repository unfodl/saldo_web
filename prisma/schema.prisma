generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OperatorRole {
  OPERATOR
  MANAGER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum CompanyCategory {
  SERVICIOS
  RECARGAS
}

model Store {
  id                      String   @id @default(cuid())
  name                    String
  crossmintWalletLocator  String?  @unique
  crossmintWalletAddress  String?
  createdAt               DateTime @default(now())

  operators Operator[]
  payments  Payment[]
}

model Operator {
  id        String       @id @default(cuid())
  email     String       @unique
  pinHash   String
  role      OperatorRole @default(OPERATOR)
  storeId   String
  createdAt DateTime     @default(now())

  store    Store     @relation(fields: [storeId], references: [id])
  payments Payment[]
}

model Company {
  id               String          @id @default(cuid())
  name             String
  logoKey          String
  category         CompanyCategory @default(SERVICIOS)
  /// Optional subsection heading within a category's mosaic (e.g. "Compañías de Cable").
  /// Companies with no group render first, ungrouped.
  group            String?
  receivingAddress String
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())

  payments Payment[]
}

model Payment {
  id                     String        @id @default(cuid())
  storeId                String
  operatorId             String
  companyId              String
  reference               String
  /// Original bill amount as entered by the operator, in MXN.
  amountMxn              Decimal?      @db.Decimal(18, 2)
  /// USDC amount actually transferred (converted from amountMxn via Saldo's exchange rate).
  amountUsdc             Decimal       @db.Decimal(18, 6)
  status                 PaymentStatus @default(PENDING)
  crossmintTransactionId String?
  txHash                 String?
  failureReason           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  operator Operator @relation(fields: [operatorId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([storeId, createdAt])
}
